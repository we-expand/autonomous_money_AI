# Chave gratuita do Groq (console.groq.com/keys)
# necessaria para o agente decidir acoes. Free tier, sem cartao de credito.
GROQ_API_KEY=

# Modelo a usar no Groq (precisa suportar tool/function calling).
# Lista atual: curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# Chave privada da carteira de TESTNET (gerada por `npm run setup-wallet`).
# NUNCA coloque aqui uma chave privada de uma carteira com fundos reais.
AGENT_PRIVATE_KEY=

# RPC da Base Sepolia (testnet). Pode usar o publico do proprio viem
# (deixe em branco) ou um endpoint dedicado (Alchemy/Infura testnet).
BASE_SEPOLIA_RPC_URL=

# Limites de seguranca do experimento
MAX_ITERATIONS=15
MAX_TX_VALUE_ETH=0.0002

# Modo continuo: roda varios ciclos de decisao em sequencia (true/false).
# Cada ciclo e uma "sessao" completa do agente (com ate MAX_ITERATIONS passos).
CONTINUOUS_MODE=false
CYCLE_DELAY_SECONDS=30
MAX_CYCLES=100
